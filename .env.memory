# OpenMemory Configuration
# This file configures the persistent memory service for AI context

# Database Configuration
# Uses SQLite by default (local-first)
# Format: sqlite:///path/to/database.sqlite
OM_DB_URL=sqlite:///RayShopeeAndroid/.memory/openmemory.sqlite

# Alternative: Use remote OpenMemory server
# OM_DB_URL=http://localhost:8080

# Memory Tier (for local mode)
# Options: fast, smart, deep, hybrid
# - fast: Single embedding, fastest ingestion
# - smart: Hybrid approach (1-3 sector embeddings)
# - deep: 5 sector embeddings, maximum accuracy
# - hybrid: Adaptive tier selection
OM_TIER=smart

# Embedding Provider
# Options: synthetic, openai, gemini, ollama, aws
OM_EMBEDDING_PROVIDER=synthetic

# OpenAI Configuration (if using openai provider)
# OPENAI_API_KEY=sk-...
# OM_OPENAI_MODEL=text-embedding-3-small
# OM_OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Configuration (if using gemini provider)
# GEMINI_API_KEY=...

# Ollama Configuration (if using ollama provider)
# OLLAMA_URL=http://localhost:11434
# OM_OLLAMA_EMBEDDING_MODEL=llama3

# AWS Bedrock Configuration (if using aws provider)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Context Management
# Maximum number of context items to retain
OM_MAX_CONTEXT_ITEMS=50

# Maximum context tokens (for LLM context windows)
OM_MAX_CONTEXT_TOKENS=4096

# Memory Decay Configuration
# How quickly memories fade (higher = slower decay)
OM_DECAY_LAMBDA=0.02

# Minimum relevance score for retrieval
OM_MIN_SCORE=0.3

# Keyword boost factor for search
OM_KEYWORD_BOOST=2.5

# Vector Store Configuration
OM_VEC_DIM=1536
OM_MAX_VECTOR_DIM=1536
OM_MIN_VECTOR_DIM=64

# Summary Configuration
OM_SUMMARY_LAYERS=3
OM_SUMMARY_MAX_LENGTH=1000

# Rate Limiting
OM_RATE_LIMIT_ENABLED=false
OM_RATE_LIMIT_WINDOW_MS=60000
OM_RATE_LIMIT_MAX=100

# Auto-reflection (periodic analysis of memories)
OM_REFLECTION_ENABLED=true
OM_REFLECTION_INTERVAL_MINUTES=10
OM_REFLECTION_MIN_MEMORIES=5

# Compression
OM_COMPRESSION_ENABLED=true
OM_COMPRESSION_ALGORITHM=semantic
OM_COMPRESSION_MIN_LENGTH=100

# Decay Configuration
OM_DECAY_ENABLED=true
OM_DECAY_INTERVAL_MINUTES=60
OM_DECAY_REINFORCE_ON_QUERY=true
OM_DECAY_COLD_THRESHOLD=0.25

# User-specific settings
# Default user ID for memory operations
OM_DEFAULT_USER=ai-assistant

# Enable/disable features
OM_ENABLE_CHAT_HISTORY=true
OM_ENABLE_RAG=true
OM_ENABLE_AUTOSUMMARY=true