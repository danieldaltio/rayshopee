{
  "name": "rayshopee",
  "version": "1.1.0",
  "description": "Shopee Price & Stock Manager — Local Dashboard",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -n \"SERVER,VITE,TUNNEL\" -c \"cyan,magenta,yellow\" \"node server/index.js\" \"vite\" \"npm run tunnel\"",
    "tunnel": "npx ngrok http 3003 --domain unpaining-transcriptionally-patrick.ngrok-free.dev",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "html5-qrcode": "^2.3.8",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "localtunnel": "^2.0.2",
    "vite": "^5.4.0"
  }
}
