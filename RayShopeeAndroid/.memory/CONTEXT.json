{
  "project": {
    "name": "RayShopeeAndroid",
    "status": "production",
    "priority": 10,
    "version": "1.0.1",
    "versionCode": 2,
    "lastUpdate": "2026-05-05"
  },
  "architecture": {
    "pattern": "MVVM",
    "layers": [
      "UI (ScannerScreen)",
      "ViewModel (ScannerViewModel)",
      "Repository (ProductRepository)",
      "Data Sources (Supabase, Shopee API)"
    ],
    "stack": {
      "language": "Kotlin 2.3.10",
      "ui": "Jetpack Compose 2026.03.00",
      "di": "Hilt 2.59.2",
      "network": "Retrofit 2.11.0",
      "persistence": "Room 2.8.4",
      "scanner": "CameraX 1.4.1 + MLKit 17.3.0"
    }
  },
  "components": {
    "MainActivity": {
      "purpose": "Entry point with ViewModel injection",
      "file": "app/src/main/java/com/rayshopee/app/MainActivity.kt"
    },
    "ScannerScreen": {
      "purpose": "Main UI with camera and barcode scanner",
      "file": "app/src/main/java/com/rayshopee/app/ui/screens/ScannerScreen.kt",
      "functions": [
        "ScannerScreen(viewModel)",
        "SimpleCameraContent(onBarcodeScanned)",
        "searchItemById(inputQuery)",
        "parseSupabaseResult(json)",
        "calculateProfit(price, cost)"
      ]
    },
    "ScannerViewModel": {
      "purpose": "Presentation logic and state management",
      "file": "app/src/main/java/com/rayshopee/app/ui/screens/ScannerViewModel.kt",
      "state": "ScannerUiState",
      "intents": [
        "BarcodeScanned(barcode)",
        "ItemIdSearch(itemId)",
        "UpdatePrice(variationId, price)",
        "UpdateStock(variationId, stock)",
        "ClearError",
        "ClearProduct"
      ]
    },
    "ProductRepository": {
      "purpose": "Data abstraction layer",
      "file": "app/src/main/java/com/rayshopee/app/data/repository/ProductRepository.kt",
      "methods": [
        "searchByBarcode(barcode)",
        "searchByItemId(itemId)",
        "updatePrice(itemId, variationId, price)",
        "updateStock(itemId, variationId, stock)"
      ]
    },
    "ProductRepositoryImpl": {
      "purpose": "Repository implementation with Supabase and Shopee API",
      "file": "app/src/main/java/com/rayshopee/app/data/repository/ProductRepositoryImpl.kt",
      "dataSources": [
        "Supabase REST (read - primary)",
        "Shopee API (write - secondary)"
      ],
      "features": [
        "Retry with exponential backoff",
        "15s timeout",
        "Error handling"
      ]
    }
  },
  "dataFlow": {
    "searchProduct": [
      "User scans barcode",
      "CameraX + MLKit detects code",
      "ScannerScreen receives barcode",
      "Dispatches BarcodeScanned intent",
      "ViewModel processes intent",
      "Calls Repository.searchByBarcode()",
      "Repository queries Supabase",
      "Supabase returns JSON",
      "Parse to Kotlin objects",
      "ViewModel updates StateFlow",
      "UI observes and recomposes",
      "User sees product"
    ],
    "updatePrice": [
      "User clicks +Price",
      "ViewModel receives intent",
      "Calls Repository.updatePrice()",
      "Repository calls Shopee API",
      "Shopee updates via Back4App",
      "Returns success/error",
      "ViewModel updates state",
      "UI shows result"
    ]
  },
  "models": {
    "Product": {
      "fields": ["itemId", "itemName", "variations"]
    },
    "ProductVariation": {
      "fields": ["variationId", "name", "price", "stock"]
    },
    "UpdatePriceRequest": {
      "fields": ["itemId", "variationId", "price"]
    },
    "UpdateStockRequest": {
      "fields": ["itemId", "variationId", "stock"]
    },
    "ScannerUiState": {
      "fields": ["isLoading", "product", "error", "lastScannedBarcode", "isUpdating"]
    }
  },
  "financial": {
    "tax": {
      "government": 0.06,
      "transaction": 0.02,
      "total": 0.08
    },
    "feeTiers": [
      {"minPrice": 0, "commission": 0.0025, "fixedFee": 4.00, "pixSubsidy": 0.00},
      {"minPrice": 12, "commission": 0.0020, "fixedFee": 4.00, "pixSubsidy": 0.00},
      {"minPrice": 80, "commission": 0.0014, "fixedFee": 16.00, "pixSubsidy": 0.01},
      {"minPrice": 100, "commission": 0.0014, "fixedFee": 16.00, "pixSubsidy": 0.01},
      {"minPrice": 150, "commission": 0.0012, "fixedFee": 22.00, "pixSubsidy": 0.01},
      {"minPrice": 300, "commission": 0.0010, "fixedFee": 36.00, "pixSubsidy": 0.02},
      {"minPrice": 500, "commission": 0.0008, "fixedFee": 46.00, "pixSubsidy": 0.02}
    ],
    "calculateProfit": "profit = revenue - cost - commission - taxes"
  },
