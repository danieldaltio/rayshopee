# =========================================================================
# ScanEditProduto — Release Keystore Configuration (TEMPLATE)
# =========================================================================
# Adicionado em 2026-07-18 (T1.3) — release signing config lê deste arquivo
#
# INSTRUÇÕES:
#   1. Copie este arquivo para app/keystore.properties
#   2. Edite os valores com as credenciais do seu keystore
#   3. NUNCA commite o app/keystore.properties (já está no .gitignore)
#
# Gerar um novo keystore:
#   keytool -genkey -v -keystore rayshopee.keystore \
#           -alias rayshopee -keyalg RSA -keysize 2048 \
#           -validity 10000 \
#           -dname "CN=RayShopee,O=RayShopee,L=SaoPaulo,ST=SP,C=BR"
#
# Se keystore.properties NÃO existir, o build usa debug.keystore com warning
# (útil pra dev local, NUNCA pra publicar).
# =========================================================================

# Caminho do keystore (relativo à raiz do projeto)
storeFile=../rayshopee.keystore

# Senha do store
storePassword=TROQUE_ESTA_SENHA

# Alias da chave
keyAlias=rayshopee

# Senha da chave
keyPassword=TROQUE_ESTA_SENHA
