# Variáveis de Ambiente do Supabase (Substitua pelos dados do seu painel)

# Para uso do Prisma (Conexão via Pooler para escalabilidade)
DATABASE_URL="postgresql://postgres.[SEU-PROJETO-ID]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Para execuções de Migrations (Conexão direta)
DIRECT_URL="postgresql://postgres.[SEU-PROJETO-ID]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Chaves do Supabase (Frontend e Backend Auth)
NEXT_PUBLIC_SUPABASE_URL="https://[SEU-PROJETO-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."

# ──────────────────────────────────────────
# SHOPEE OPEN PLATFORM
# Cadastre-se em: https://open.shopee.com
# ──────────────────────────────────────────
# Seu Partner ID (numérico) - fornecido pela Shopee ao criar o aplicativo
SHOPEE_PARTNER_ID=

# Sua Partner Key (secreta! nunca commite no git)
SHOPEE_PARTNER_KEY=

# URL de callback — DEVE ser exatamente igual ao cadastrado no painel da Shopee
SHOPEE_REDIRECT_URL=http://localhost:3001/shopee/callback

# URL base da API (Produção ou Sandbox)
# Produção:  https://partner.shopeemobile.com
# Sandbox:   https://partner.test-stable.shopeemobile.com
SHOPEE_BASE_URL=https://partner.test-stable.shopeemobile.com

# ──────────────────────────────────────────
# FRONTEND (para redirecionamentos pós-OAuth)
# ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
